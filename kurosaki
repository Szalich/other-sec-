#include <iostream>
using namespace std;

void count(int arr[], int &positive, int &negative, int &zero);
void sumPositive(int arr[]);
void sumNegative(int arr[]);
void average(int arr[]);

int main()
{
    int arr[5];
    int positive = 0, negative = 0, zero = 0;

    cout << "Enter 5 numbers: ";

    for(int i = 0; i < 5; i++)
    {
        cin >> arr[i];
    }

    count(arr, positive, negative, zero);

    cout << "Positive numbers = " << positive << endl;
    cout << "Negative numbers = " << negative << endl;
    cout << "Zeros = " << zero << endl;

    sumPositive(arr);
    sumNegative(arr);
    average(arr);

    return 0;
}

void count(int arr[], int &positive, int &negative, int &zero)
{
    for(int i = 0; i < 5; i++)
    {
        if(arr[i] > 0)
            positive++;
        else if(arr[i] < 0)
            negative++;
        else
            zero++;
    }
}

void sumPositive(int arr[])
{
    int sum = 0;

    for(int i = 0; i < 5; i++)
    {
        if(arr[i] > 0)
            sum += arr[i];
    }

    cout << "Positive sum = " << sum << endl;
}

void sumNegative(int arr[])
{
    int sum = 0;

    for(int i = 0; i < 5; i++)
    {
        if(arr[i] < 0)
            sum += arr[i];
    }

    cout << "Negative sum = " << sum << endl;
}

void average(int arr[])
{
    int sum = 0;

    for(int i = 0; i < 5; i++)
    {
        sum += arr[i];
    }

    cout << "Average = " << (double)sum / 5 << endl;
}
